        {
            "parameters": {
                "jsCode": "\nfor (const item of $input.all()) {\n  \n  // destructure items to check\n  const category = item.json.category\n  const tier = item.json.body.plan_tier ?item.json.body.plan_tier.toLowerCase() : \"free\"\n  const subject = item.json.subject_lc \n  const body = item.json.body_lc\n\n  // keywords\n  const keywords = subject + body\n\n  // keyword tests\n  const hasCriticalKeywords = /urgent|immediately|down|outage|can't access/.test(keywords)\n  const hasTechnicalKeywords = /error|bug|crash|not working|glitch|account|password|login|register|sign up|sign in/.test(keywords)\n\n  /** tests for critical|high|normal categories */\n  if((category === \"billing\" && tier === \"pro\") || (tier === \"pro\" && hasCriticalKeywords)) {\n    item.json.urgency = \"critical\"\n  } else if(tier === \"pro\" && hasTechnicalKeywords) {\n    item.json.urgency = \"high\"\n  } else {\n    item.json.urgency = \"normal\"\n  }\n  \n}\n\nreturn $input.all();"
            },
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [1088, 96],
