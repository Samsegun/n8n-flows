        {
            "parameters": {
                "jsCode": "// 1. Get all the original SKUs from the initial order placement node\nconst originalOrderItems = $('order placed').item.json.body.items || []; \n\n// 2. Get the successful matches from Search Inventory\nconst foundInventoryItems = $input.all();\n\n// Filter out any empty items created by 'Always Output Data' and map the valid SKUs\nconst foundSkus = new Set(\n  foundInventoryItems\n    .filter(item => item.json && item.json.fields && item.json.fields['SKU'])\n    .map(item => item.json.fields['SKU'])\n); \n\n// 3. Filter out the SKUs that exist in the order but were NOT found in inventory\nconst invalidItems = originalOrderItems.filter(item => !foundSkus.has(item.sku));\n\n// 4. Output the results safely\nreturn [{\n  json: {\n    has_mismatch: invalidItems.length > 0,\n    total_ordered: originalOrderItems.length,\n    total_found: foundSkus.size,\n    invalid_skus: invalidItems \n  }\n}];\n"
            },
